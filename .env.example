# PostgreSQL
DB_NAME=resume_analyzer
DB_USER=appuser
DB_PASSWORD=apppassword
DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/resume_analyzer

# JWT auth (use a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# MinIO (S3-compatible storage for uploaded files)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=resumes
MINIO_USE_SSL=false
